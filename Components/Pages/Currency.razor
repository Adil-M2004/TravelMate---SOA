@page "/currency"
@rendermode InteractiveServer
@using TravelMate.Services
@inject CurrencyService CurrencyService

@* This page lets the user enter an amount and request a current exchange rate. *@
<PageTitle>Currency Converter - TravelMATE</PageTitle>

<h1>Currency Converter</h1>

<p>Convert currencies using the latest available exchange rates.</p>

<div class="card p-4 mt-4">

    @* The amount and currency selectors form the input for the conversion. *@
    <div class="mb-3">
        <label class="form-label">Amount</label>
        <InputNumber @bind-Value="amount"
                     class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">From Currency</label>

        <select class="form-select" @bind="fromCurrency">
            <option value="EUR">EUR - Euro</option>
            <option value="USD">USD - US Dollar</option>
            <option value="GBP">GBP - British Pound</option>
            <option value="JPY">JPY - Japanese Yen</option>
            <option value="AUD">AUD - Australian Dollar</option>
            <option value="CAD">CAD - Canadian Dollar</option>
            <option value="CHF">CHF - Swiss Franc</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">To Currency</label>

        <select class="form-select" @bind="toCurrency">
            <option value="USD">USD - US Dollar</option>
            <option value="EUR">EUR - Euro</option>
            <option value="GBP">GBP - British Pound</option>
            <option value="JPY">JPY - Japanese Yen</option>
            <option value="AUD">AUD - Australian Dollar</option>
            <option value="CAD">CAD - Canadian Dollar</option>
            <option value="CHF">CHF - Swiss Franc</option>
        </select>
    </div>

    <button class="btn btn-primary"
            @onclick="ConvertCurrency"
            disabled="@isLoading">
        @(isLoading ? "Converting..." : "Convert Currency")
    </button>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">
            @errorMessage
        </div>
    }

    @* Show the answer only after a successful conversion or same-currency shortcut. *@
    @if (result != null)
    {
        <div class="alert alert-success mt-4">
            <h4>Conversion Result</h4>

            <h3>
                @amount.ToString("N2") @fromCurrency =
                @result.ConvertedAmount.ToString("N2") @toCurrency
            </h3>

            <p>
                Exchange Rate: 1 @fromCurrency =
                @result.Rate @toCurrency
            </p>

            <small>Rate Date: @result.Date</small>
        </div>
    }

</div>

@code {
    // These fields are bound to the form controls and keep the conversion state.
    private decimal amount = 100;
    private string fromCurrency = "EUR";
    private string toCurrency = "USD";

    private CurrencyResponse? result;
    private string? errorMessage;
    private bool isLoading;

    private async Task ConvertCurrency()
    {
        // Clear the previous answer before validating the new request.
        result = null;
        errorMessage = null;

        // A currency amount must be greater than zero.
        if (amount <= 0)
        {
            errorMessage = "Please enter an amount greater than zero.";
            return;
        }

        // No API call is needed when both currencies are the same.
        if (fromCurrency == toCurrency)
        {
            result = new CurrencyResponse
            {
                Base = fromCurrency,
                Quote = toCurrency,
                Rate = 1,
                ConvertedAmount = amount,
                Date = DateTime.Today.ToString("yyyy-MM-dd")
            };
            return;
        }

        isLoading = true;

        try
        {
            // Ask the service to retrieve the latest rate and calculate the result.
            result = await CurrencyService.ConvertCurrencyAsync(
                fromCurrency, toCurrency, amount);

            if (result == null)
            {
                errorMessage = "No exchange rate was returned.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to retrieve exchange rates. Please try again.";
        }
        catch (Exception)
        {
            errorMessage = "An unexpected error occurred.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
