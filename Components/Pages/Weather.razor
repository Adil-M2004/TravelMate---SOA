@page "/weather"
@rendermode InteractiveServer
@using TravelMate.Services
@inject WeatherService WeatherService

<PageTitle>Weather - TravelMATE</PageTitle>

<h1>Destination Weather</h1>

<p>Check the current weather at your travel destination.</p>

<div class="mb-3">
    <label class="form-label">Choose a destination:</label>

    <select class="form-select" @bind="selectedCity">
        <option value="Dublin">Dublin, Ireland</option>
        <option value="London">London, UK</option>
        <option value="Tokyo">Tokyo, Japan</option>
        <option value="Dubai">Dubai, UAE</option>
        <option value="New York">New York, USA</option>
    </select>
</div>

<button class="btn btn-primary" @onclick="GetWeather">
    Check Weather
</button>

@if (isLoading)
{
    <p class="mt-3">Loading weather information...</p>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">
        @errorMessage
    </div>
}

@if (weather != null && weather.Current != null)
{
    <div class="card mt-4">
        <div class="card-body">
            <h3>Weather in @selectedCity</h3>

            <p>Temperature: @weather.Current.Temperature_2m °C</p>
            <p>Humidity: @weather.Current.Relative_humidity_2m%</p>
            <p>Wind Speed: @weather.Current.Wind_speed_10m km/h</p>
        </div>
    </div>
}

@code {
    private string selectedCity = "Dublin";
    private WeatherResponse? weather;
    private bool isLoading = false;
    private string? errorMessage;

    private readonly Dictionary<string, (double Lat, double Lon)> cities = new()
    {
        { "Dublin", (53.3498, -6.2603) },
        { "London", (51.5074, -0.1278) },
        { "Tokyo", (35.6762, 139.6503) },
        { "Dubai", (25.2048, 55.2708) },
        { "New York", (40.7128, -74.0060) }
    };

    private async Task GetWeather()
    {
        isLoading = true;
        errorMessage = null;
        weather = null;

        try
        {
            var location = cities[selectedCity];

            weather = await WeatherService.GetWeatherAsync(
                location.Lat,
                location.Lon
            );

            if (weather?.Current == null)
            {
                errorMessage = "Weather data is unavailable.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Unable to retrieve weather information.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
