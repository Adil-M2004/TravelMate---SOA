@page "/weather"
@rendermode InteractiveServer
@using TravelMate.Services
@inject WeatherService WeatherService
@inject GeocodingService GeocodingService

@* This page searches for a city first, then loads weather for the selected result. *@
<PageTitle>Destination Weather - TravelMATE</PageTitle>

<h1>Destination Weather</h1>
<p>Search for any city to check its current weather.</p>

<div class="card p-4 mt-4">

    <label class="form-label">Enter a destination</label>

    <div class="input-group mb-3">
        <input class="form-control"
               placeholder="e.g. Tokyo, Lahore, Paris"
               @bind="searchText"
               @bind:event="oninput" />

        <button class="btn btn-primary"
                @onclick="SearchCities"
                disabled="@isLoading">
            Search
        </button>
    </div>

    @if (isLoading)
    {
        <p>Loading...</p>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @* Show possible matches so the user can choose the correct city. *@
    @if (cities.Count > 0)
    {
        <h5>Select a destination:</h5>

        <div class="list-group mb-3">
            @foreach (var city in cities)
            {
                <button class="list-group-item list-group-item-action"
                        @onclick="() => SelectCity(city)">
                    @city.Name,
                    @city.Region,
                    @city.Country
                </button>
            }
        </div>
    }

    @* Weather is displayed only after both a city and current data are available. *@
    @if (weather?.Current != null && selectedCity != null)
    {
        <div class="card mt-3">
            <div class="card-body">
                <h3>
                    Weather in @selectedCity.Name,
                    @selectedCity.Country
                </h3>

                <hr />

                <p>
                    Temperature:
                    @weather.Current.Temperature_2m °C
                </p>

                <p>
                    Humidity:
                    @weather.Current.Relative_humidity_2m%
                </p>

                <p>
                    Wind Speed:
                    @weather.Current.Wind_speed_10m km/h
                </p>
            </div>
        </div>
    }
</div>

@code {
    // These fields hold the search text and the data displayed by the page.
    private string searchText = "";
    private List<CityResult> cities = new();
    private CityResult? selectedCity;
    private WeatherResponse? weather;
    private bool isLoading;
    private string? errorMessage;

    private async Task SearchCities()
    {
        // Start each search with a clean result area.
        isLoading = true;
        errorMessage = null;
        cities.Clear();
        weather = null;
        selectedCity = null;

        try
        {
            // A short search is unlikely to return a useful city result.
            if (searchText.Trim().Length < 2)
            {
                errorMessage = "Enter at least two characters.";
                return;
            }

            // First find matching coordinates; weather needs those coordinates.
            cities = await GeocodingService
                .SearchCitiesAsync(searchText);

            if (cities.Count == 0)
            {
                errorMessage = "No matching cities found.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Unable to search destinations.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectCity(CityResult city)
    {
        // Save the selected city and replace the search results with its weather.
        selectedCity = city;
        cities.Clear();
        weather = null;
        errorMessage = null;
        isLoading = true;

        try
        {
            weather = await WeatherService.GetWeatherAsync(
                city.Latitude,
                city.Longitude);

            if (weather?.Current == null)
            {
                errorMessage = "Weather data is unavailable.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Unable to retrieve weather.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
